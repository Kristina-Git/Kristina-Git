DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trade_order_dev"
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
PORT=4000
# Orders at or above this notional value require Compliance Officer sign-off
# before execution (four-eyes control).
COMPLIANCE_APPROVAL_THRESHOLD=100000

# For local dev without installing Postgres, run:
#   docker run --name trade-order-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=trade_order_dev -p 5432:5432 -d postgres:16

# Invite links (client account setup) are built against this URL if set, otherwise the
# server guesses from the incoming request. Set this explicitly when running the client and
# server as separate local dev processes (uncomment the line below), or if a custom domain/
# CDN sits in front of the deployed app such that Express doesn't see the real public host.
# APP_BASE_URL="http://localhost:5173"

# Optional: automated invite emails. Without these, invite links are still generated and
# shown in the UI for you to share manually -- nothing breaks, this just skips the "send"
# step. Any standard SMTP provider works (Gmail app password, SendGrid, Postmark, Resend, etc).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="apikey-or-username"
# SMTP_PASS="your-smtp-password-or-api-key"
# SMTP_FROM="Cayman Trade Order System <no-reply@yourdomain.com>"
